// Disposable 046 native painting experiment. No production asset format.
package desktop

import (
    "bytes"
    "crypto/sha256"
    "encoding/binary"
    "encoding/json"
    "fmt"
    "image"
    "image/color"
    "image/png"
    "os"
    "path/filepath"

    "github.com/hajimehoshi/ebiten/v2"
    "github.com/hajimehoshi/ebiten/v2/text/v2"
    "github.com/hajimehoshi/ebiten/v2/vector"
    "github.com/wicanr2/superfighter-remastered/internal/gamecore"
)

type titlePrototypePaint struct {
    person *ebiten.Image
    phases [8]*ebiten.Image
    cursor *ebiten.Image
    rgba []byte
    cursorKey string
}

func loadTitlePrototypePaint() *titlePrototypePaint {
    root:=os.Getenv("KDZZ_TITLE_PROTOTYPE_ART");if root==""{return nil}
    data,e:=os.ReadFile(filepath.Join(root,"colour-transfer.json"));if e!=nil||len(data)>128*1024{return nil}
    if fmt.Sprintf("%x",sha256.Sum256(data))!="aa6257add12bdd573dec1f65d16878e6225d8f1efa4beaaa14d34c5f3c36de34"{return nil}
    return loadCheckedTitlePrototypePaint(root,data)
}

func loadCheckedTitlePrototypePaint(root string,data []byte) *titlePrototypePaint {
    var manifest struct{ArtSHA string `json:"art_sha256"`;Masked bool `json:"source_material_mask"`;Frames []struct{Phase int `json:"phase"`;File string `json:"file"`;SHA string `json:"sha256"`} `json:"frames"`}
    if json.Unmarshal(data,&manifest)!=nil||!manifest.Masked||len(manifest.Frames)!=8||manifest.ArtSHA!="3f224d17e40bdcdbf08a50be7e393a9d8cb708c779d659b9e4f4ba61de949ccc"{return nil}
    read:=func(path,hash string,w,h int)*ebiten.Image{info,e:=os.Stat(path);if e!=nil||info.Size()>16*1024*1024{return nil};b,e:=os.ReadFile(path);if e!=nil||fmt.Sprintf("%x",sha256.Sum256(b))!=hash{return nil};config,e:=png.DecodeConfig(bytes.NewReader(b));if e!=nil||config.Width!=w||config.Height!=h{return nil};im,e:=png.Decode(bytes.NewReader(b));if e!=nil{return nil};return ebiten.NewImageFromImage(im)}
    paint:=&titlePrototypePaint{cursor:ebiten.NewImage(320,200),rgba:make([]byte,64000*4)}
    paint.person=read("/project/assets/hd/candidates/title-person-v1.png","fc38cc33915afc7bbbf4caf39ed7c69409069d7b9d8436904709667a7a9bf3ea",1586,992);if paint.person==nil{return nil}
    for _,frame:=range manifest.Frames{if frame.Phase<0||frame.Phase>=8||paint.phases[frame.Phase]!=nil||filepath.Base(frame.File)!=frame.File{return nil};texture:=read(filepath.Join(root,frame.File),frame.SHA,1983,793);if texture==nil{return nil};paint.phases[frame.Phase]=texture.SubImage(image.Rect(61,153,1952,621)).(*ebiten.Image)}
    return paint
}

func (g *Game) drawTitlePrototype(dst *ebiten.Image,state *gamecore.TitlePrototypeState)bool{
    paint:=g.titlePrototypePaint;if paint==nil||state==nil{return false}
    physical:=func(x,y float64)(float64,float64){return float64(g.paintRect.Min.X)+x*3,float64(g.paintRect.Min.Y)+y*3}
    op:=&ebiten.DrawImageOptions{Filter:ebiten.FilterLinear};op.GeoM.Scale(960.0/1586,600.0/992);op.GeoM.Translate(float64(g.paintRect.Min.X),float64(g.paintRect.Min.Y));dst.DrawImage(paint.person,op)
    op=&ebiten.DrawImageOptions{Filter:ebiten.FilterLinear};op.GeoM.Scale(855.0/1891,207.0/468);x,y:=physical(18,96);op.GeoM.Translate(x,y);dst.DrawImage(paint.phases[state.Phase],op)
    labels:=[4]string{"單　打","雙　打","設　定","結　束"}
    face:=&text.GoTextFace{Source:g.face.Source,Size:28.8}
    for i,box:=range state.Buttons{
        x,y:=physical(float64(box[0]),float64(box[1]));w,h:=float64(box[2]-box[0]+2)*3,float64(box[3]-box[1])*3
        vector.DrawFilledRect(dst,float32(x),float32(y),float32(w),float32(h),color.RGBA{79,57,102,255},false)
        ink:=color.RGBA{187,155,216,255};if i==state.Selected{ink=color.RGBA{state.Flash[0],state.Flash[1],state.Flash[2],255}}
        vector.StrokeRect(dst,float32(x+1),float32(y+1),float32(w-2),float32(h-2),2,ink,false)
        width,height:=text.Measure(labels[i],face,0);if width>w-8||height>h{return false}
        options:=&text.DrawOptions{};options.GeoM.Translate(x+(w-width)/2,y+(h-height)/2);options.ColorScale.ScaleWithColor(color.RGBA{250,239,255,255});text.Draw(dst,labels[i],face,options)
    }
    if !state.CursorHidden{
        key:=fmt.Sprintf("%d:%v:%v",state.CursorOffset,state.Palette[0],state.Palette[255])
        if key!=paint.cursorKey{
            clear(paint.rgba)
            for y:=0;y<16;y++{black,white:=binary.LittleEndian.Uint16(state.Masks[y*2:]),binary.LittleEndian.Uint16(state.Masks[32+y*2:]);for x:=0;x<16;x++{position:=(int(state.CursorOffset)+y*320+x)&65535;if position>=64000{continue};index:=-1;if black&(1<<(15-x))==0{index=0};if white&(1<<(15-x))!=0{index=255};if index>=0{rgb:=state.Palette[index];copy(paint.rgba[position*4:position*4+3],rgb[:]);paint.rgba[position*4+3]=255}}}
            paint.cursor.WritePixels(paint.rgba);paint.cursorKey=key
        }
        op=&ebiten.DrawImageOptions{};op.GeoM.Scale(3,3);op.GeoM.Translate(float64(g.paintRect.Min.X),float64(g.paintRect.Min.Y));dst.DrawImage(paint.cursor,op)
    }
    return true
}
